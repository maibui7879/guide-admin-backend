NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://atlas:atlas_local@localhost:5432/atlas
# Development only: keep false unless temporarily bypassing DB certificate verification.
DATABASE_SSL_INSECURE=false
SESSION_SECRET=replace-with-at-least-32-random-characters
API_ORIGIN=http://localhost:3000
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
# Set these locally only when running pnpm admin:bootstrap, then remove them.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=atlas-local
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=local-placeholder
STORAGE_SECRET_KEY=local-placeholder
LOG_LEVEL=info

# local dev files; use s3 in production with the STORAGE_* settings above
MEDIA_STORAGE_DRIVER=local
# MEDIA_LOCAL_DIR=C:/path/to/private-media

# Backend worker (API can run without Redis; worker requires this).
# REDIS_URL=redis://localhost:6379/0
# Production requires rediss:// and HTTPS storage/origins.
PUBLIC_RATE_LIMIT_PER_MINUTE=300
# Set only when the API is reachable solely through the stated trusted proxy hops.
TRUST_PROXY_HOPS=0
# Backup tools: native by default, or docker / wsl.
# BACKUP_TOOL_MODE=wsl
# BACKUP_WSL_DISTRO=Ubuntu
# BACKUP_DIR=.cache/backups
# RESTORE_TEST_DATABASE_URL=postgresql://operator:password@localhost:5437/atlas_restore_test
