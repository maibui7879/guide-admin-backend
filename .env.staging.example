# Copy to .env.staging (gitignored). Use a separate staging database and private bucket.
# Fill locally or through the hosting secret manager; never paste secrets into chat.
NODE_ENV=production
PORT=3000
DATABASE_URL=
DATABASE_SSL_INSECURE=false
SESSION_SECRET=
API_ORIGIN=https://api.staging.example.com
CORS_ORIGINS=https://staging.example.com
MEDIA_STORAGE_DRIVER=s3
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
LOG_LEVEL=info
PUBLIC_RATE_LIMIT_PER_MINUTE=300
TRUST_PROXY_HOPS=0
# Optional on API; required on the separate worker. Production requires TLS.
# REDIS_URL=rediss://...
# Supply the provider CA if the standard Node trust store does not trust it.
# NODE_EXTRA_CA_CERTS=C:/private/provider-ca.pem

# Remote smoke test (no login credentials needed).
STAGING_API_ORIGIN=https://api.staging.example.com
STAGING_WEB_ORIGIN=https://staging.example.com
STAGING_GAME_SLUG=stella-sora
# Explicit permission for the storage probe to write/delete its own random image.
STORAGE_VERIFY_ALLOW_WRITE=false
